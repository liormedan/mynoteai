# Local development defaults: everything runs on the Firebase Emulator Suite
# under the "demo-mynoteai" project, which needs no Google account or cloud
# project. None of these values are secrets.
# To develop against your real Firebase project, override them in .env.local.

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mynoteai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mynoteai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mynoteai.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Used by next-firebase-auth-edge on the server to talk to the Auth emulator.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# The single owner of this install. In the emulator, sign in with Google and
# pick "Add new account" with this address.
OWNER_EMAIL=owner@example.com

# Cookie signing keys for local development only.
COOKIE_SECRET_CURRENT=dev-only-cookie-secret-current-0123456789abcdef
COOKIE_SECRET_PREVIOUS=dev-only-cookie-secret-previous-0123456789abcdef
