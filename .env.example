# Environment variables for mynoteai.
#
# Local development needs none of these: `pnpm dev` uses .env.development and
# the Firebase Emulator Suite. Fill them in for your real Firebase project:
#   - .env.production.local  for `pnpm rules:deploy` and `pnpm build && pnpm start`
#   - Vercel → Project → Settings → Environment Variables (Production and Preview)

# Firebase web app config: Firebase console → Project settings → Your apps.
# These are public by design; access is enforced by the security rules.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true only if Cloud Storage is set up (Blaze plan); otherwise images are links.
NEXT_PUBLIC_FIREBASE_STORAGE_ENABLED=false

# The single owner of this install. Only this verified email can sign in.
OWNER_EMAIL=

# Random strings, at least 32 characters, that sign the session cookies.
# Rotate by moving CURRENT to PREVIOUS and generating a new CURRENT.
COOKIE_SECRET_CURRENT=
COOKIE_SECRET_PREVIOUS=

# Service account (secret): Firebase console → Project settings →
# Service accounts → Generate new private key. Copy client_email and
# private_key from the JSON; keep the \n escapes in the key.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# MCP server for agents (Claude Code, Claude Desktop, Cursor) at /api/mcp.
# Off when empty. A random secret of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Agents send it as "Authorization: Bearer <MCP_TOKEN>". It gives full
# access to the notebook: treat it like a password.
MCP_TOKEN=
