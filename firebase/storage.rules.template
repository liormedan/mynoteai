rules_version = '2';

// Generated from firebase/storage.rules.template by scripts/firebase-rules.mjs.
// Cloud Storage is optional (it needs the Blaze plan); without it the editor
// falls back to image links.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == "{{OWNER_EMAIL}}";
    }

    match /pages/{pageId}/{fileName} {
      allow read: if isOwner();
      allow write: if isOwner()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if isOwner();
    }
  }
}
