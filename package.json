{
  "name": "mynoteai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:cloud": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-rtl.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-mynoteai-rules \"vitest run --config vitest.rules.config.ts\"",
    "rules:deploy": "node scripts/firebase-rules.mjs --deploy",
    "format": "prettier --write src *.ts *.mjs *.json",
    "format:check": "prettier --check src *.ts *.mjs *.json",
    "plan:check": "node scripts/plan-check.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/shadcn": "0.55.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "12.19.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-firebase-auth-edge": "1.12.1",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "15.32.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.1"
}
